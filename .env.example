# angi-mcp needs no credentials — every tool reads public angi.com pages.
# Both settings below are optional.

# Override the fetchproxy concentrator port. The whole fetchproxy fleet shares
# 37149 and the Transporter extension dials that one port, so change this only
# if you know why.
# ANGI_WS_PORT=37149

# Verbose bridge logging to stderr.
# ANGI_DEBUG=1

{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chrischall/angi-mcp",
  "description": "Angi for Claude — find home-service pros by trade and city, read ratings and reviews",
  "repository": {
    "url": "https://github.com/chrischall/angi-mcp",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@chrischall/angi-mcp",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ANGI_WS_PORT",
          "description": "Override the fetchproxy WebSocket port (default 37149).",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
